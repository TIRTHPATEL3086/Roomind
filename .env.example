# ─── Core ──────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ─── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=roommind
POSTGRES_PASSWORD=roommind
POSTGRES_DB=roommind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://roommind:roommind@localhost:5432/roommind
DATABASE_URL_SYNC=postgresql+psycopg2://roommind:roommind@localhost:5432/roommind

# ─── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── MQTT ──────────────────────────────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_CLIENT_ID=roommind-backend
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS=1

# ─── Vector DB ─────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=roommind_scene
EMBED_MODEL=all-MiniLM-L6-v2
# lexical | chroma. Lexical is the default: it answers the same queries with no
# network and no startup cost. Chroma's embedder downloads ~79 MB on first index
# and blocked startup for 37 s here — worth it at hundreds of objects, not at 9.
RAG_BACKEND=lexical

# ─── LLM ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
LLM_MODEL=claude-opus-5
LLM_EFFORT=high
LLM_MAX_TOKENS=16000
MOCK_LLM=false                 # true = fully offline rule-based fallback

# ─── Storage ───────────────────────────────────────────────────────────────
STORAGE_ROOT=./storage
MESH_MAX_MB=25
DRACO_COMPRESSION=true

# ─── Robot (ARIA — there is exactly one) ───────────────────────────────────
ROBOT_MODE=sim                 # sim | hardware
ROBOT_ID=aria
ROBOT_DISPLAY_NAME=ARIA
ROBOT_ACCENT=#3B82F6
ROBOT_GLOW=#22D3EE
ROBOT_HAS_WAIST=false          # true if you fitted the optional waist-yaw servo
ROBOT_ARM_REACH_M=0.24         # used by point_at + the placement solver
COMMAND_TIMEOUT_S=30
ESTOP_LATENCY_BUDGET_MS=200

# ─── Imagine (image → 3D, §10B) ────────────────────────────────────────────
IMAGINE_ENABLED=true
IMAGINE_BACKEND=auto           # auto | triposr | trellis | proxy
IMAGINE_DEVICE=cpu             # cuda | cpu
IMAGINE_TIMEOUT_S=45           # exceed this → fall back to the textured proxy (§10B.7)
IMAGINE_MAX_UPLOAD_MB=8
IMAGINE_MAX_TRIS=40000
IMAGINE_MAX_GLB_MB=2
IMAGINE_REMBG_MODEL=u2net
IMAGINE_SIZE_ESTIMATOR=vlm     # vlm | prior_table | manual
IMAGINE_MODEL_CACHE=./storage/genai3d_models
IMAGINE_OUT_DIR=./storage/generated

# ─── Safety ────────────────────────────────────────────────────────────────
GEOFENCE_MARGIN_M=0.15
MIN_OBSTACLE_DIST_M=0.25
MAX_SPEED_MPS=0.45

# ─── ML ────────────────────────────────────────────────────────────────────
YOLO_WEIGHTS=./ml/models/yolo_furniture_v1.pt
YOLO_ONNX=./ml/models/yolo_furniture_v1.onnx
YOLO_CONF=0.35
YOLO_IOU=0.5
DEPTH_MODEL=midas_small
DEVICE=cpu                     # cuda | cpu

# ─── Speech ────────────────────────────────────────────────────────────────
STT_ENGINE=whisper_local       # whisper_local | browser
TTS_ENGINE=browser             # browser | elevenlabs
ELEVENLABS_API_KEY=
